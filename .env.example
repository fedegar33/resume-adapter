# Copy to .env.local. All these values are server-only.
# Leave credentials empty to run the scaffold without external services.
OPENAI_API_KEY=
# One server-configured model and its default reasoning effort.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low

# Tracing starts automatically when a Braintrust API key is provided.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=resume-adapter

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Name reserved for a future PRIVATE bucket; not provisioned by the scaffold.
SUPABASE_STORAGE_BUCKET=resumes
