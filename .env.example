# Copy to .env.local. All these values are server-only.
# Leave credentials empty to view the home page without external services.
# Upload requires Supabase; metadata extraction requires OpenAI; HTML requires Docker.
OPENAI_API_KEY=
# One server-configured model and its default reasoning effort.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low

# The SDK discovers credentials automatically; set this explicitly in production.
BRAINTRUST_API_KEY=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Existing PRIVATE bucket; see docs/SUPABASE_SETUP.md for manual setup.
SUPABASE_STORAGE_BUCKET=resumes

# Optional Docker CLI path; defaults to docker on PATH. Start Docker Desktop first.
# Run pnpm pdf:setup once to download the pinned conversion image.
PDF2HTMLEX_DOCKER_PATH=
