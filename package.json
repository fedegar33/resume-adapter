{
  "name": "resume-adapter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "pdf:setup": "node scripts/setup-pdf-html.mjs",
    "postinstall": "pnpm assets:prepare",
    "predev": "pnpm assets:prepare",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "prebuild": "pnpm assets:prepare",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.104",
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.155",
    "braintrust": "3.40.0",
    "client-only": "^0.0.1",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  }
}
